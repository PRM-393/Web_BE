# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Nhieu origin cach nhau dau phay, ho tro *.vercel.app
CORS_ORIGIN=http://localhost:5173,https://*.vercel.app

# ---- Database: postgres (mac dinh) hoac mysql ----
# Cach 1 (CSDL cloud Neon / Supabase): chi can DATABASE_URL, bo qua cac bien DB_HOST..DB_NAME ben duoi
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/voucher_platform?sslmode=require
# Cach 2 (may ca nhan): dien tung bien
# MySQL: DB_TYPE=mysql, DB_PORT=3306, DB_USERNAME=root (xem database/README.md)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=voucher_platform
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=60d

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_REQUESTS_PER_HOUR=5

# ---- Cong thanh toan payOS (https://my.payos.vn -> Kenh thanh toan -> Thong tin tich hop) ----
# De trong 3 khoa thi khong tao link thanh toan, dung PAYMENT_SIMULATOR de demo.
PAYMENT_GATEWAY=PAYOS
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/api/orders/payment-return
PAYOS_CANCEL_URL=http://localhost:3000/api/orders/payment-return
# Webhook URL khai bao trong trang payOS: https://<ten-mien-BE>/api/orders/payos-webhook
# true: cho phep POST /api/orders/:id/simulate-payment de demo khi chua co khoa payOS (TAT o ban that)
PAYMENT_SIMULATOR=true

# ---- SMTP (OTP / notification email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=changeme@gmail.com
SMTP_PASSWORD=changeme
SMTP_FROM="Voucher Platform <no-reply@voucherplatform.local>"

# ---- Firebase Cloud Messaging (push notification) ----
FIREBASE_PROJECT_ID=changeme
FIREBASE_CLIENT_EMAIL=changeme
FIREBASE_PRIVATE_KEY=changeme

# ---- Redeem QR token (F10 / F11) ----
REDEEM_TOKEN_TTL_SECONDS=60
# Khoa ky ma QR (HMAC-SHA256). Bat buoc khi NODE_ENV=production; sinh bang: openssl rand -hex 32
REDEEM_HMAC_SECRET=change_me_redeem_hmac_secret
# Moi khach toi da 10 lan sinh ma / 10 phut
REDEEM_TOKEN_MAX_PER_WINDOW=10
REDEEM_TOKEN_RATE_WINDOW_MINUTES=10
# Sai OTP 5 lan trong 5 phut -> khoa o nhap OTP cua nhan vien 15 phut (QR van dung duoc)
REDEEM_OTP_MAX_FAILS=5
REDEEM_OTP_FAIL_WINDOW_MINUTES=5
REDEEM_OTP_LOCK_MINUTES=15
# Sua gia tri hoa don trong 10 phut sau khi xac nhan
BILL_EDIT_WINDOW_MINUTES=10

# ---- Order stock hold ----
ORDER_RESERVATION_TTL_MINUTES=15

# ---- Refund window (BR-05) ----
REFUND_WINDOW_DAYS=7
REFUND_MIN_DAYS_BEFORE_EXPIRE=3
# F12: auto = goi cong hoan tien; manual = moi yeu cau du dieu kien vao hang doi quan tri (MANUAL_PENDING)
REFUND_MODE=auto
# Cong hoan tien gia lap (payOS khong co API hoan tien): success | declined | unavailable
REFUND_SANDBOX_RESULT=success

# ---- Commission (default, overridable via SystemConfig table) ----
DEFAULT_COMMISSION_RATE=0.1

# URL frontend để tạo liên kết kích hoạt
WEB_APP_URL=http://localhost:5173
